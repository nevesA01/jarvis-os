# Windows 11 — valores reais devem ser configurados fora do repositório.
JARVIS_AGENT_DATA_DIR=%LOCALAPPDATA%\\Jarvis\\LocalAgent
JARVIS_WORKSPACE_DIR=%USERPROFILE%\\JarvisWorkspace
# Obrigatório para conexão real; deve começar com wss://
JARVIS_VPS_WSS_URL=wss://SEU-DOMINIO-JARVIS.example/ws/local-agent
# Token de curta duração entregue pelo fluxo de pareamento. Nunca versione este valor.
JARVIS_ACCESS_TOKEN=
# Chave pública do serviço de jobs da VPS, em base64. Nunca use a chave privada aqui.
JARVIS_VPS_SIGNING_PUBLIC_KEY=
